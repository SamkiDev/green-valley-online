generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  STORE_STAFF
  DRIVER
  ADMIN
}
enum OrderStatus {
  PLACED
  PAID
  PREPARING
  PACKED
  OUT_FOR_DELIVERY
  DELIVERED
  READY_FOR_COLLECTION
  COLLECTED
  CANCELLED
}
enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}
enum DeliveryStatus {
  PENDING
  ASSIGNED
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  ARRIVED
  DELIVERED
  FAILED
  CANCELLED
}
enum Fulfilment {
  DELIVERY
  COLLECTION
}

model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  name String
  role Role
  phone String?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  customer Customer?
  driver Driver?
  staff StoreStaff?
  admin Admin?
}
model Customer {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields: [userId], references: [id])
  addresses Address[]
  orders Order[]
  carts Cart[]
  favourites Favourite[]
  reviews Review[]
  questions Question[]
}
model Admin {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields: [userId], references: [id])
}
model StoreStaff {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields: [userId], references: [id])
  storeId String
  store Store @relation(fields: [storeId], references: [id])
}
model Driver {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields: [userId], references: [id])
  vehicle String?
  deliveries Delivery[]
}
model Store {
  id String @id @default(cuid())
  slug String @unique
  name String
  category String
  description String?
  status String @default("COMING_SOON") // ACTIVE | COMING_SOON
  ageRestricted Boolean @default(false)
  config Json @default("{}") // whatsapp, hours, compliance text (configurable, no hard-coded legal claims)
  createdAt DateTime @default(now())
  staff StoreStaff[]
  products Product[]
  zones DeliveryZone[]
  orders Order[]
  reviews Review[]
}
model DeliveryZone {
  id String @id @default(cuid())
  storeId String
  store Store @relation(fields: [storeId], references: [id])
  name String
  fee Decimal @db.Decimal(10, 2)
  active Boolean @default(true)
}
model Category {
  id String @id @default(cuid())
  name String @unique
  products Product[]
}
model Product {
  id String @id @default(cuid())
  storeId String
  store Store @relation(fields: [storeId], references: [id])
  categoryId String
  category Category @relation(fields: [categoryId], references: [id])
  name String
  description String
  price Decimal @db.Decimal(10, 2)
  soldByWeight Boolean @default(false)
  imageUrl String?
  popularity Int @default(0)
  active Boolean @default(true) // false = unavailable (hidden from the shop)
  deletedAt DateTime? // soft delete: kept for order history, hidden from admin lists
  isDemo Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  inventory Inventory?
  cartItems CartItem[]
  orderItems OrderItem[]
  favourites Favourite[]
  reviews Review[]
  questions Question[]
  @@index([storeId, active])
}
model Inventory {
  id String @id @default(cuid())
  productId String @unique
  product Product @relation(fields: [productId], references: [id])
  quantity Decimal @db.Decimal(10, 2)
  lowThreshold Decimal @default(5) @db.Decimal(10, 2)
  updatedAt DateTime @updatedAt
}
model Cart {
  id String @id @default(cuid())
  customerId String
  customer Customer @relation(fields: [customerId], references: [id])
  items CartItem[]
  updatedAt DateTime @updatedAt
}
model CartItem {
  id String @id @default(cuid())
  cartId String
  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product Product @relation(fields: [productId], references: [id])
  quantity Decimal @db.Decimal(10, 2)
  @@unique([cartId, productId])
}
model Address {
  id String @id @default(cuid())
  customerId String? // null for guest orders
  customer Customer? @relation(fields: [customerId], references: [id])
  saved Boolean @default(false) // true = shown in the customer's saved addresses
  label String?
  createdAt DateTime @default(now())
  street String
  area String
  city String
  province String
  postalCode String
  orders Order[]
}
model Order {
  id String @id @default(cuid())
  seq Int @unique @default(autoincrement()) // display number: "GV" + (10283 + seq)
  customerId String?
  customer Customer? @relation(fields: [customerId], references: [id])
  storeId String // primary store; each item carries its own storeId for future multi-store orders
  store Store @relation(fields: [storeId], references: [id])
  // Contact details captured at checkout (for signed-in customers and, later, guests)
  contactName String?
  contactPhone String?
  contactEmail String?
  ageConfirmedAt DateTime? // set when the customer confirmed their age for an age-restricted store
  addressId String?
  address Address? @relation(fields: [addressId], references: [id])
  addressText String?
  area String?
  fulfilment Fulfilment
  status OrderStatus @default(PLACED)
  subtotal Decimal @db.Decimal(10, 2)
  deliveryFee Decimal @db.Decimal(10, 2)
  total Decimal @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items OrderItem[]
  payment Payment?
  delivery Delivery?
  events OrderStatusEvent[]
}
model OrderStatusEvent { // history of order status changes; feeds the tracking timeline
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id])
  status OrderStatus
  actorUserId String?
  at DateTime @default(now())
  @@index([orderId, at])
}
model OrderItem {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id])
  productId String
  product Product @relation(fields: [productId], references: [id])
  storeId String
  nameSnapshot String
  unitPrice Decimal @db.Decimal(10, 2)
  quantity Decimal @db.Decimal(10, 2)
  lineTotal Decimal @db.Decimal(10, 2)
}
model Payment { // never store card data
  id String @id @default(cuid())
  orderId String @unique
  order Order @relation(fields: [orderId], references: [id])
  provider String
  providerRef String?
  method String
  status PaymentStatus @default(PENDING)
  amount Decimal @db.Decimal(10, 2)
  createdAt DateTime @default(now())
}
model Delivery {
  id String @id @default(cuid())
  orderId String @unique
  order Order @relation(fields: [orderId], references: [id])
  driverId String?
  driver Driver? @relation(fields: [driverId], references: [id])
  status DeliveryStatus @default(PENDING)
  assignedAt DateTime?
  pickedUpAt DateTime?
  departedAt DateTime?
  arrivedAt DateTime?
  deliveredAt DateTime?
  // Latest driver position (shown to the customer only while out for delivery)
  lastLat Float?
  lastLng Float?
  lastAccuracy Float?
  lastLocationAt DateTime?
  updates DeliveryStatusUpdate[]
  points TrackingPoint[]
}
model TrackingPoint { // GPS history while a delivery is on the road; purged after 30 days
  id String @id @default(cuid())
  deliveryId String
  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  lat Float
  lng Float
  accuracy Float?
  at DateTime @default(now())
  @@index([deliveryId, at])
  @@index([at])
}
model DeliveryStatusUpdate {
  id String @id @default(cuid())
  deliveryId String
  delivery Delivery @relation(fields: [deliveryId], references: [id])
  status DeliveryStatus
  actorUserId String?
  lat Float? // reserved for real GPS tracking later; unused while tracking is simulated
  lng Float?
  at DateTime @default(now())
}
model Review {
  id String @id @default(cuid())
  customerId String
  customer Customer @relation(fields: [customerId], references: [id])
  productId String?
  product Product? @relation(fields: [productId], references: [id])
  storeId String
  store Store @relation(fields: [storeId], references: [id])
  rating Int
  comment String
  createdAt DateTime @default(now())
}
model Question {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields: [productId], references: [id])
  customerId String?
  customer Customer? @relation(fields: [customerId], references: [id])
  text String
  createdAt DateTime @default(now())
  answers Answer[]
}
model Answer {
  id String @id @default(cuid())
  questionId String
  question Question @relation(fields: [questionId], references: [id])
  text String
  approved Boolean @default(false)
  authorUserId String
  createdAt DateTime @default(now())
}
model WholesaleRequest {
  id String @id @default(cuid())
  name String
  business String
  phone String
  email String
  products String
  quantity String
  preferredDate String?
  notes String?
  createdAt DateTime @default(now())
}
model Favourite {
  id String @id @default(cuid())
  customerId String
  customer Customer @relation(fields: [customerId], references: [id])
  productId String
  product Product @relation(fields: [productId], references: [id])
  @@unique([customerId, productId])
}
