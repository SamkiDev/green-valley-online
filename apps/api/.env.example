DATABASE_URL="postgresql://postgres:postgres@localhost:5432/greenvalley"   # add ?connection_limit=10 for more database connections
JWT_SECRET="change-me-to-a-long-random-string"   # at least 24 characters
WEB_ORIGIN="http://localhost:5180"   # the site's public address; also where Paystack returns customers
PAYMENT_PROVIDER="demo"   # demo | paystack
PAYSTACK_SECRET_KEY=""    # sk_test_... from your Paystack dashboard. Server-side only; never commit it.
ALLOW_LIVE_PAYMENTS="false" # live keys (sk_live_...) are refused unless this is true
SEED_PASSWORD=""          # optional; demo accounts default to demo-password-1
UNPAID_ORDER_MINUTES="30" # unpaid orders are cancelled and their stock returned after this many minutes
RATE_LIMIT_PER_MINUTE="300" # API requests per minute per client address
AUTH_LIMIT_PER_15_MIN="30" # sign-in/register attempts per device per 15 minutes (each account also allows 10 failures)
TRUST_PROXY=""            # behind a hosting proxy set e.g. 1 so rate limits see real client addresses
STORAGE_PROVIDER="local"  # local (apps/api/uploads) | database (photos in Postgres; for hosts that wipe their disk)

# Vallerie answers in basic mode (from the catalogue, no AI) when no key below is set.

# Vallerie (AI assistant). Server-side only. Never expose these to the frontend or commit them.
AI_PROVIDER="anthropic"   # anthropic | xai
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"
XAI_API_KEY=""
XAI_MODEL=""              # set to the Grok model you have access to
AI_TIMEOUT_MS="20000"
