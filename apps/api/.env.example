DATABASE_URL="postgresql://postgres:postgres@localhost:5432/greenvalley"
JWT_SECRET="change-me-to-a-long-random-string"   # at least 24 characters
WEB_ORIGIN="http://localhost:5180"
PAYMENT_PROVIDER="demo"   # demo | paystack
PAYSTACK_SECRET_KEY=""    # sk_test_... from your Paystack dashboard. Server-side only; never commit it.
ALLOW_LIVE_PAYMENTS="false" # live keys (sk_live_...) are refused unless this is true
SEED_PASSWORD=""          # optional; demo accounts default to demo-password-1

# Vallerie (AI assistant). Server-side only. Never expose these to the frontend or commit them.
AI_PROVIDER="anthropic"   # anthropic | xai
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"
XAI_API_KEY=""
XAI_MODEL=""              # set to the Grok model you have access to
AI_TIMEOUT_MS="20000"
